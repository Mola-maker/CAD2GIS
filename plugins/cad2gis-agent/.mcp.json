{
  "mcpServers": {
    "cad2gis": {
      "command": "cad2gis-agent-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env_vars": [
        "CAD2GIS_BACKEND_PATH",
        "CAD2GIS_CACHE_DIR",
        "CAD2GIS_GCP_TOOL_PATH",
        "CAD2GIS_PROJECT_ROOT",
        "CAD2GIS_PROJECT_ROOTS",
        "CAD2GIS_READER_BACKEND",
        "CAD2GIS_LIBREDWG_CLI",
        "CAD2GIS_ACCORECONSOLE",
        "CAD2GIS_ACCORECONSOLE_TIMEOUT",
        "DEEPSEEK_API_KEY",
        "NEWAPI_API_KEY"
      ]
    }
  }
}
