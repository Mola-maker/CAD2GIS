.omc/.gitignore

# robustness: pipeline run outputs (generated, not source)
baselines/*/run/
baselines/*/run.review/
baselines/*/review/

# robustness: scripts directory stays out of version control
/scripts/*

# robustness: verification output artifacts
baselines/apd_hutabohu/output/

# robustness: temp venv caches
.pytest_cache/
__pycache__/
*.egg-info/
node_modules/
_site-hero-smoke/
.pytest-hero-verify-*/

.dsh-funnel/

tmp/
tmp.screenshot/

raw/

# Derived demonstrations are fetched from a hash-pinned release, not source code.
/pages-delivery/
/experiment/*.dwg
!scripts/fetch_derived_release.py

# baselines: version only the frozen project config and the SVG review project.
# Every other generated artifact (run/, reviews/, delivery GeoPackages and review
# receipts) stays local. config/.osm-cache is part of the frozen config: the
# content-addressed Overpass snapshots keep offline OSM matching reproducible.
# Order matters - later patterns win - so the SVG review project is re-included
# explicitly and everything else is ignored again.
/baselines/*/*
!/baselines/*/config
!/baselines/*/config/**
!/baselines/*/delivery
/baselines/*/delivery/*
!/baselines/*/delivery/view-with-source-SVG.qgz
!/baselines/*/delivery/*/
/baselines/*/delivery/*/*
!/baselines/*/delivery/*/view-with-source-SVG.qgz

# Tool state can be created below any working directory.
**/.omc/

# Local browser acceptance artifacts and Chromium diagnostics.
/output/
/debug.log

# Source verifier and local custom-domain preview.
!scripts/verify_public_site.py
/_official_site/

!tools/build_agent_delivery.py

!tools/registry_status.py

# Official public website imported from the owner-approved local release.
!/site/
!/site/**
!scripts/build_local_demo.py

/_official_preview/
