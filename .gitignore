.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Python
__pycache__/
*.py[cod]
.venv/

# Demo output
demo/output/

# Temp
*.tmp
*.bak
/baselines/*/config/*.bak.*
/temp/
/.firecrawl/

# QGIS project files
*.qgz

# Worktrees
.worktrees/

# Plugins
# Keep local/experimental plugins ignored, but version the supported agent plugin.
/plugins/*
!/plugins/cad2gis-agent/
!/plugins/cad2gis-agent/**

# Official reference Shape files
/official/Shape/

# robustness: test temp & build junk (cleaned at branch creation)
.pytest-tmp-*
build/
dist/
/_site/
/.pytest-webdemo-build-*/
ErrorReports/

# robustness: dev replay artifacts
experiment/py_scripts/replay_apd_libredwg_dev_report.json
/tmp/apd_libredwg_dev_replay*/

# robustness: OMC transient state
.omc/state/
.omc/sessions/
.omc/project-memory.json
.omc/.gitignore

# robustness: pipeline run outputs (generated, not source)
baselines/*/run/
baselines/*/run.review/
baselines/*/review/

# robustness: scripts directory stays out of version control
/scripts/*

# robustness: verification output artifacts
baselines/apd_hutabohu/output/

# robustness: temp venv caches
.pytest_cache/
__pycache__/
*.egg-info/
node_modules/
_site-hero-smoke/
.pytest-hero-verify-*/

.dsh-funnel/

tmp/
tmp.screenshot/

raw/

# Derived demonstrations are fetched from a hash-pinned release, not source code.
/pages-delivery/
/experiment/*.dwg
!scripts/fetch_derived_release.py

# baselines: version only the frozen project config and the SVG review project.
# Every other generated artifact (run/, reviews/, delivery GeoPackages and review
# receipts) stays local. config/.osm-cache is part of the frozen config: the
# content-addressed Overpass snapshots keep offline OSM matching reproducible.
# Order matters - later patterns win - so the SVG review project is re-included
# explicitly and everything else is ignored again.
/baselines/*/*
!/baselines/*/config
!/baselines/*/config/**
!/baselines/*/delivery
/baselines/*/delivery/*
!/baselines/*/delivery/view-with-source-SVG.qgz
!/baselines/*/delivery/*/
/baselines/*/delivery/*/*
!/baselines/*/delivery/*/view-with-source-SVG.qgz

# Tool state can be created below any working directory.
**/.omc/
