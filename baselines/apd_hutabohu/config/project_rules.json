{
  "project": "apd_hutabohu",
  "description": "APD - DUSUN MENARA DAN PUSAT HUTABOHU GORONTALO",
  "tolerances": {
    "fragment_cluster_m": 50.0,
    "annotation_link_m": 15.0,
    "boite_fusion_m": 5.0,
    "snap_m": 5.0,
    "isolation_m": 30.0,
    "chain_m": 0.5,
    "site_snap_max_m": 50.0
  },
  "code_prefix": {
    "SITE": "PM",
    "BOITE": "PBO",
    "PTECH": "PT",
    "IMB": "IMB",
    "CABLE": "CBL",
    "INFRASTRUCTURE": "INF",
    "ZPM": "ZPM",
    "ZNRO": "ZNR"
  },
  "expected_census": {
    "model_entities": 6940,
    "model_inserts": 222,
    "model_dimensions": 170,
    "plan_poles": 167,
    "plan_fat": 43,
    "plan_fdt": 2,
    "direct_fat_annotations": 43,
    "direct_new_pole_annotations": 118,
    "direct_existing_pole_annotations": 49,
    "direct_pole_annotations": 167,
    "homepass_labels": 682,
    "positive_cable_routes": 6,
    "source_route_curve_facts": 6,
    "source_route_native_lengths": 6,
    "source_route_components": 2,
    "source_route_nodes": 141,
    "source_route_edges": 139,
    "route_vertices_exact_support": 129,
    "route_vertices_near_support_candidates": 15,
    "route_vertices_unresolved": 1,
    "cable_route_span_dimensions": 130,
    "sling_wire_span_dimensions": 40,
    "route_segments_with_span_dimension": 130,
    "route_segments_without_span_dimension": 9,
    "accepted_span_dimensions": 168,
    "candidate_span_dimensions": 2,
    "accepted_unique_span_edges": 163,
    "all_unique_span_edges": 164
  },
  "label_families": [
    {
      "family": "fat",
      "pattern": "^DMPH-\\d+\\.\\d+\\.[A-Z]\\d{2}$",
      "target_fc": "BOITE"
    },
    {
      "family": "pole",
      "pattern": "^MR\\.DMPH\\.P\\d+$",
      "target_fc": "PTECH",
      "node_color_filter": "!#FF0000",
      "min_distance_m": 15
    },
    {
      "family": "pole_ext",
      "pattern": "^EXT\\.MR\\.\\w+\\.\\w+\\.\\w+\\.P\\d+$",
      "target_fc": "PTECH",
      "node_color_filter": "#FF0000",
      "min_distance_m": 25
    }
  ],
  "layer_pattern_map": [
    ["(?i).*fat\\s*area.*|.*boundary\\s*fat.*|.*hp\\s*cover.*|.*zpm.*|.*zone.*pm.*|.*zone.*sro.*|.*distribution.*zone.*|.*service.*zone.*", "ZPM", "Polygon"],
    ["(?i).*fdt.*", "SITE", "Point"],
    ["(?i).*\\bfat\\b.*|^nap.*|.*box.*|.*slimbox.*|.*blackbox.*|.*closure.*|.*cto.*|.*dp\\b|.*ont.*|.*pedestal.*|.*splice.*|.*splitter.*|.*spliter.*|.*patch.*|.*panel.*|.*terminal.*|.*otb.*|.*fsc.*|.*boite.*|.*hw-fat.*", "BOITE", "Point"],
    ["(?i).*pole.*|.*poteau.*|.*chamber.*|.*chambre.*|.*manhole.*|.*handhole.*|.*anchor.*|.*guy\\b|.*vault.*|.*ptech.*|.*gaine\\s*technique.*|.*gc\\s|.*appui.*|.*ancrage.*|.*hw-handhole.*|.*iam\\s*mh.*", "PTECH", "Point"],
    ["(?i).*home\\s*number.*|.*home\\s*pass.*|.*building.*|.*batiment.*|.*premise.*|.*house.*|.*unit.*|.*apartment.*|.*office.*|.*mdu.*|.*sdu.*|.*imb.*|.*property.*|.*address.*|.*customer.*|.*subscriber.*|.*logement.*|.*maison.*|.*villa.*|.*immeuble.*|.*residence.*", "IMB", "Point"],
    ["(?i).*duct.*|.*conduit.*|.*pipe.*|.*trench.*|.*infra.*|.*pathway.*|.*route.*|.*buried.*|.*underground.*|.*aerial.*|.*fourreau.*|.*adduction.*|.*branchement.*|.*raccordement.*|.*gaine.*|.*new\\s*duct.*|.*pit.*|.*handhole.*|.*chamber.*", "INFRASTRUCTURE", "LineString"],
    ["(?i).*cable.*|.*fib[er]*e.*|.*feeder.*|.*trunk.*|.*distribution.*|.*drop.*|.*riser.*|.*lateral.*|.*backbone.*|.*access.*|.*span\\s*cable.*|.*micro\\s*cable.*|.*loose\\s*cable.*|.*sling\\s*wire.*|.*suspension\\s*wire.*|.*span\\s*sling.*|.*sling.*|.*fo\\s*\\d+\\s*core.*|.*fo\\s*cable.*|.*service\\s*core.*|.*expansion\\s*core.*|.*moniter\\s*core.*|.*monitor\\s*core.*|^line$", "CABLE", "LineString"],
    ["(?i).*site.*|.*nro.*|.*pm\\b|.*exchange.*|.*node.*|.*hub.*|.*pop\\b|.*co\\b|.*shelter.*|.*cabinet.*|.*location.*|.*olt.*|.*ftts.*|.*local.*tech.*", "SITE", "Point"],
    ["(?i).*znro.*|.*zone.*nro.*|.*olt.*zone.*|.*exchange.*zone.*|.*coverage.*|.*service.*area.*", "ZNRO", "Polygon"]
  ]
}
